-- START
--------------------------------------------------------

Start.MouseButton1Click:Connect(function()

    if Running then
        return
    end

    if #Waypoints == 0 then

        UpdateStatus(
            T("noWaypoint")
        )

        return

    end

    Running = true

    task.spawn(function()

        local TotalRuns =
            LoopEnabled
            and LoopCount
            or 1

        for CurrentRun = 1, TotalRuns do

            if not Running then
                break
            end

            for i, waypoint in ipairs(Waypoints) do

                if not Running then
                    break
                end

                if not Root or not Root.Parent then
                    GetCharacter()
                end

                UpdateStatus(
                    T("running")
                    .. "  "
                    .. i
                    .. " / "
                    .. #Waypoints
                    .. "   •   "
                    .. CurrentRun
                    .. " / "
                    .. TotalRuns
                )

                Root.CFrame =
                    waypoint.CFrame

                task.wait(
                    DelayTime
                )

            end

        end

        if Running then

            UpdateStatus(
                T("completed")
            )

        else

            UpdateStatus(
                T("stopped")
            )

        end

        Running = false

    end)

end)

