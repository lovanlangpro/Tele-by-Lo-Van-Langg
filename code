--------------------------------------------------------
-- DELAY UPDATE
--------------------------------------------------------

local function UpdateDelay()

    DelayValue.Text =
        string.format(
            "%.2fs",
            DelayTime
        )

    local sliderValue =
        math.clamp(
            DelayTime,
            1,
            50
        )

    local percent =
        (sliderValue - 1) / 49

    Fill.Size =
        UDim2.new(
            percent,
            0,
            1,
            0
        )

    Knob.Position =
        UDim2.new(
            percent,
            0,
            0.5,
            0
        )

    Warning.Text =
        T("warning")

    Warning.Visible =
        DelayTime < 1.5

end

--------------------------------------------------------
-- SLIDER
--------------------------------------------------------

local SliderDragging = false

Slider.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        SliderDragging = true

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        SliderDragging = false

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not SliderDragging then
        return
    end

    if input.UserInputType ~=
        Enum.UserInputType.MouseMovement then

        return

    end

    local X =
        input.Position.X -
        Slider.AbsolutePosition.X

    local Percent =
        math.clamp(
            X / Slider.AbsoluteSize.X,
            0,
            1
        )

    DelayTime =
        1 + Percent * 49

    DelayTime =
        math.floor(
            DelayTime * 10 + 0.5
        ) / 10

    DelayBox.Text =
        tostring(DelayTime)

    UpdateDelay()

end)

--------------------------------------------------------
-- CUSTOM INPUT
--------------------------------------------------------

DelayBox.FocusLost:Connect(function()

    local Number =
        tonumber(DelayBox.Text)

    if Number then

        DelayTime =
            math.max(
                0.05,
                Number
            )

    else

        DelayTime = 1

    end

    DelayBox.Text =
        tostring(DelayTime)

    UpdateDelay()

end)

