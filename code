local DebugFolder = Instance.new("Folder")
DebugFolder.Name = "LoVanLang_DebugWaypoints"
DebugFolder.Parent = workspace

local function CreateDebugPoint(index, cframe)

    if not DebugEnabled then
        return
    end

    local Part = Instance.new("Part")

    Part.Name = "Waypoint_" .. index
    Part.Size = Vector3.new(1.5, 1.5, 1.5)
    Part.CFrame = cframe

    Part.Anchored = true
    Part.CanCollide = false
    Part.CanTouch = false
    Part.CanQuery = false

    Part.Material = Enum.Material.Neon
    Part.Color = RED_LIGHT
    Part.Shape = Enum.PartType.Ball
    Part.Transparency = 0.15

    Part.Parent = DebugFolder

    local Light = Instance.new("PointLight")

    Light.Color = RED_LIGHT
    Light.Brightness = 1.5
    Light.Range = 8

    Light.Parent = Part

    local Billboard = Instance.new("BillboardGui")

    Billboard.Size = UDim2.fromOffset(110, 35)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = Part

    local Label = Instance.new("TextLabel")

    Label.Size = UDim2.fromScale(1, 1)
    Label.BackgroundTransparency = 1

    Label.Text = "WAYPOINT " .. index

    Label.TextColor3 = WHITE
    Label.TextStrokeTransparency = 0.4

    Label.TextSize = 12
    Label.Font = Enum.Font.GothamBold

    Label.Parent = Billboard

    task.spawn(function()

        local Original = Part.Position

        while Part.Parent do

            local Up = TweenService:Create(
                Part,
                TweenInfo.new(
                    0.8,
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                ),
                {
                    Position =
                        Original +
                        Vector3.new(0, 0.6, 0)
                }
            )

            Up:Play()
            Up.Completed:Wait()

            if not Part.Parent then
                break
            end

            local Down = TweenService:Create(
                Part,
                TweenInfo.new(
                    0.8,
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                ),
                {
                    Position = Original
                }
            )

            Down:Play()
            Down.Completed:Wait()

        end

    end)

end

local function RefreshDebug()

    DebugFolder:ClearAllChildren()

    if not DebugEnabled then
        return
    end

    for i, waypoint in ipairs(Waypoints) do
        CreateDebugPoint(
            i,
            waypoint.CFrame
        )
    end

end

