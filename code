local function AddHover(Button)

    Button.AutoButtonColor = false
    Button.ClipsDescendants = true

    local Hover =
        Instance.new("Frame")

    Hover.Name =
        "HoverGlow"

    Hover.Size =
        UDim2.new(1, 0, 1, 0)

    Hover.BackgroundColor3 =
        RED

    Hover.BackgroundTransparency =
        1

    Hover.BorderSizePixel = 0

    Hover.ZIndex =
        Button.ZIndex + 1

    Hover.Parent = Button

    local HoverCorner =
        Instance.new("UICorner")

    HoverCorner.CornerRadius =
        UDim.new(0, 10)

    HoverCorner.Parent = Hover

    local Stroke =
        Instance.new("UIStroke")

    Stroke.Color =
        RED_LIGHT

    Stroke.Thickness = 1

    Stroke.Transparency = 1

    Stroke.Parent = Button

    Button.MouseEnter:Connect(function()

        TweenService:Create(
            Hover,
            TweenInfo.new(
                0.16,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundTransparency = 0.90
            }
        ):Play()

        TweenService:Create(
            Stroke,
            TweenInfo.new(0.16),
            {
                Transparency = 0.25
            }
        ):Play()

    end)

    Button.MouseLeave:Connect(function()

        TweenService:Create(
            Hover,
            TweenInfo.new(
                0.20,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundTransparency = 1
            }
        ):Play()

        TweenService:Create(
            Stroke,
            TweenInfo.new(0.20),
            {
                Transparency = 1
            }
        ):Play()

    end)

    Button.MouseButton1Down:Connect(function()

        TweenService:Create(
            Hover,
            TweenInfo.new(0.06),
            {
                BackgroundTransparency = 0.78
            }
        ):Play()

    end)

    Button.MouseButton1Up:Connect(function()

        TweenService:Create(
            Hover,
            TweenInfo.new(0.10),
            {
                BackgroundTransparency = 0.90
            }
        ):Play()

    end)

end

